{
  "name": "telegram-bot-websockets",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/EugeneDraitsev/telegram-bot-websockets"
  },
  "author": "Eugene Draitsev <ddrrai@gmail.com>",
  "license": "MIT",
  "scripts": {
    "start": "sls offline start --stage local",
    "build": "sls package",
    "tsc": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "biome": "biome check ./src",
    "biome:fix": "biome check ./src --fix --unsafe",
    "lint": "bun run biome",
    "lint:fix": "bun run biome:fix",
    "format": "biome format --write ./src",
    "logs:connect": "sls logs -t -f connect",
    "logs:disconnect": "sls logs -t -f disconnect",
    "logs:stats": "sls logs -t -f stats",
    "logs:broadcastStats": "sls logs -t -f broadcastStats",
    "logs:updateChatData": "sls logs -t -f updateChatData",
    "deploy": "sls deploy"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1046.0",
    "@aws-sdk/client-dynamodb": "^3.1046.0",
    "@aws-sdk/lib-dynamodb": "^3.1046.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^25.8.0",
    "esbuild": "0.27.4",
    "serverless": "^4.36.1",
    "serverless-esbuild": "^1.57.1",
    "serverless-offline": "^14.6.0",
    "typescript": "^6.0.3"
  }
}
